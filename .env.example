# Backend API base (Vercel deploy ke baad backend URL daalo)
VITE_API_BASE_URL=http://localhost:5000/api

# Google Sign-In (Google Cloud Console → OAuth Client ID)
VITE_GOOGLE_CLIENT_ID=<google-cloud-oauth-client-id>

# Admin panel ka secret path (repo me hardcoded nahi).
# Example: VITE_ADMIN_PATH=/meri-secret-jagah-77
# Badalne ke baad Vercel par REDEPLOY zaroori hai (build-time value).
VITE_ADMIN_PATH=/admin-secret-29
